@namespace Pages.Reporting.Designer.Internal

<div class="rd-list" style="gap:@StyleCss.Gap(Spacing)">
    @* Graph-paper overlay; the same lattice tints blue while dragging. *@
    <div class="rd-gridlines @(ShowGrid ? "rd-on" : null)"></div>

    <DropZone TargetList="Elements" Index="0" Dragging="Dragging" AllowSections="AllowSections"
              Wide="@(Elements.Count == 0)" OnDrop="OnDrop" />

    @for (var i = 0; i < Elements.Count; i++)
    {
        var element = Elements[i];
        <div class="rd-el @(ReferenceEquals(element, Selected) ? "rd-selected" : null)"
             style="@CellStyle(element)"
             draggable="true" data-drag="move" @key="element"
             @onclick="() => OnSelect.InvokeAsync(element)" @onclick:stopPropagation
             @ondragstart="() => OnMoveStart.InvokeAsync((element, Elements))"
             @ondragstart:stopPropagation
             @ondragend="() => OnDragEnd.InvokeAsync()">
            <div class="rd-el-badge">
                <button type="button" class="rd-el-w" title="Narrower (snap one grid line)"
                        @onclick="() => Resize(element, -1)" @onclick:stopPropagation>◂</button>
                <span class="rd-el-span">@Span(element)/12</span>
                <button type="button" class="rd-el-w" title="Wider (snap one grid line)"
                        @onclick="() => Resize(element, +1)" @onclick:stopPropagation>▸</button>
                <span class="rd-el-sep"></span>
                <span>@TypeName(element)</span>
                <button type="button" class="rd-el-x" title="Remove"
                        @onclick="() => OnRemove.InvokeAsync(element)" @onclick:stopPropagation>✕</button>
            </div>
            @if (element is SectionElement section)
            {
                <div class="rd-el-section" style="@StyleCss.Inline(section.Style)">
                    @if (!string.IsNullOrEmpty(section.Title))
                    {
                        <span class="rd-el-section-title">@section.Title</span>
                    }
                    <CanvasList Elements="section.Children"
                                Selected="Selected"
                                Dragging="Dragging"
                                ShowGrid="ShowGrid"
                                Spacing="@Spacing"
                                AllowSections="false"
                                DefaultSpan="@SectionChildSpan(section)"
                                OnSelect="OnSelect"
                                OnRemove="OnRemove"
                                OnMoveStart="OnMoveStart"
                                OnDragEnd="OnDragEnd"
                                OnDrop="OnDrop" />
                </div>
            }
            else
            {
                <ElementSkeleton Element="element" />
            }
        </div>
        <DropZone TargetList="Elements" Index="i + 1" Dragging="Dragging" AllowSections="AllowSections"
                  OnDrop="OnDrop" />
    }
</div>

@code {
    [Parameter, EditorRequired] public required List<ReportElement> Elements { get; set; }
    [Parameter] public ReportElement? Selected { get; set; }
    [Parameter] public bool Dragging { get; set; }
    [Parameter] public bool ShowGrid { get; set; }
    [Parameter] public string? Spacing { get; set; }
    [Parameter] public bool AllowSections { get; set; } = true;
    [Parameter] public int DefaultSpan { get; set; } = 12;
    [Parameter] public EventCallback<ReportElement> OnSelect { get; set; }
    [Parameter] public EventCallback<ReportElement> OnRemove { get; set; }
    [Parameter] public EventCallback<(ReportElement, List<ReportElement>)> OnMoveStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }
    [Parameter] public EventCallback<(List<ReportElement>, int, bool)> OnDrop { get; set; }

    private int Span(ReportElement element) => Math.Clamp(element.ColumnSpan ?? DefaultSpan, 1, 12);

    private string CellStyle(ReportElement element) =>
        $"grid-column:span {Span(element)}"
        + (element.RowSpan is > 1 and { } rows ? $";grid-row:span {Math.Clamp(rows, 1, 24)}" : string.Empty)
        + (StyleCss.Length(element.MinHeight) is { } height ? $";min-height:{height}" : string.Empty);

    // Same rule the renderer uses: custom column count wins; else row sections split evenly.
    internal static int SectionChildSpan(SectionElement section)
    {
        if (section.Columns is { } columns && columns > 0)
            return Math.Max(1, 12 / Math.Clamp(columns, 1, 12));
        return section.Direction == SectionDirection.Row && section.Children.Count > 0
            ? Math.Max(1, 12 / section.Children.Count)
            : 12;
    }

    private async Task Resize(ReportElement element, int delta)
    {
        var span = Math.Clamp(Span(element) + delta, 1, 12);
        element.ColumnSpan = span == 12 && DefaultSpan == 12 ? null : span;
        await OnSelect.InvokeAsync(element); // selecting re-renders the designer + properties panel
    }

    internal static string TypeName(ReportElement element) => element switch
    {
        TextElement => "Text",
        TitleElement => "Text (legacy)",
        ValueElement => "Label + value (legacy)",
        KpiCardElement => "KPI card",
        ChartElement chart => $"Chart · {chart.ChartType}",
        TableElement => "Table",
        SectionElement { Columns: { } columns } => $"Section · {columns}/row",
        SectionElement section => $"Section · {(section.Direction == SectionDirection.Row ? "row" : "column")}",
        _ => element.GetType().Name,
    };
}
