@* The card structure (border, spacing, type scale) is structural like the table's
   borders — it must look the same on screen, in the designer, and in the PDF without
   developer CSS. Element.Style and developer CSS hooks still override it. *@
<div class="pr-kpi @Element.CssClass"
     style="@StyleCss.Concat(CardStyle, StyleCss.Concat(StyleCss.Inline(Element.Style), AccentStyle))">
    <span class="pr-label" style="display:block;font-size:12.5px;color:#6a6f76">@Element.Label</span>
    @if (Data.Error is not null)
    {
        <span class="pr-error-inline" title="@Data.Error">unavailable</span>
    }
    else
    {
        <span class="pr-kpi-value" style="display:block;font-size:26px;font-weight:650">@ValueFormatter.Format(Data.Scalar, Element.Format)</span>
    }
    @if (!string.IsNullOrEmpty(Element.Caption))
    {
        <span class="pr-caption" style="display:block;font-size:11.5px;color:#8a8f97">@Element.Caption</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public required KpiCardElement Element { get; set; }
    [CascadingParameter] public required ResolvedReport Resolved { get; set; }

    private const string CardStyle =
        "display:flex;flex-direction:column;gap:2px;border:1px solid #d0d3d8;border-radius:10px;padding:12px 14px;";

    private ResolvedData Data => Resolved.GetData(Element);

    private string? AccentStyle =>
        string.IsNullOrEmpty(Element.Accent) ? null : $"--pr-accent:{Element.Accent};";
}
