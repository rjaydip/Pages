@namespace Pages.Reporting.Designer.Internal

@* Data-less stand-in for one element: real configured text, ghost placeholders for data.
   Applies the element's built-in Style so styling changes show live while designing. *@

@switch (Element)
{
    case TextElement text:
        <div class="sk-text @(text.RenderHtml ? "sk-text-html" : null)" style="@StyleCss.Inline(text.Style)">
            @if (string.IsNullOrEmpty(text.Content))
            {
                <span class="sk-text-empty">Text</span>
            }
            else
            {
                @foreach (var token in TextTemplate.Tokenize(text.Content))
                {
                    @if (token.Expression is { } expression)
                    {
                        <span class="sk-pill">@ExpressionLabel(expression)</span>
                    }
                    else if (text.RenderHtml)
                    {
                        @((MarkupString)token.Raw)
                    }
                    else
                    {
                        @token.Raw
                    }
                }
            }
        </div>
        break;

    case TitleElement title:
        <div class="sk-title" style="@StyleCss.Container(title.Style)">
            <span class="sk-h1" style="@StyleCss.Text(title.Style)">@(string.IsNullOrWhiteSpace(title.Text) ? "Title" : title.Text)</span>
            @if (!string.IsNullOrEmpty(title.Subtitle))
            {
                <span class="sk-sub">@title.Subtitle</span>
            }
        </div>
        break;

    case ValueElement value:
        <div class="sk-value" style="@StyleCss.Inline(value.Style)">
            <span class="sk-label">@value.Label</span>
            <span class="sk-pill">123</span>
        </div>
        break;

    case KpiCardElement kpi:
        <div class="sk-kpi" style="@StyleCss.Inline(kpi.Style)">
            <span class="sk-label">@kpi.Label</span>
            <span class="sk-kpi-figure">1,234</span>
            @if (!string.IsNullOrEmpty(kpi.Caption))
            {
                <span class="sk-caption">@kpi.Caption</span>
            }
        </div>
        break;

    case ChartElement chart:
        <div class="sk-chart" style="@StyleCss.Inline(chart.Style)">
            @if (!string.IsNullOrEmpty(chart.Title))
            {
                <span class="sk-chart-title">@chart.Title</span>
            }
            <div class="sk-chart-body" style="height:@(Math.Clamp(chart.Height, 80, 480))px">
                @((MarkupString)ChartGhost(chart.ChartType))
            </div>
        </div>
        break;

    case TableElement table:
        <div class="sk-tablewrap" style="@StyleCss.Inline(table.Style)">
            @if (!string.IsNullOrEmpty(table.Title))
            {
                <span class="sk-chart-title">@table.Title</span>
            }
            <table class="sk-table">
                <thead>
                <tr>
                    @foreach (var column in Columns(table))
                    {
                        <th style="@AlignStyle(column)">@(column.Header ?? column.Field)</th>
                    }
                </tr>
                </thead>
                <tbody>
                @for (var row = 0; row < 3; row++)
                {
                    <tr>
                        @{ var col = 0; }
                        @foreach (var column in Columns(table))
                        {
                            <td style="@AlignStyle(column)"><span class="sk-bar" style="width:@(GhostWidth(row, col++))%"></span></td>
                        }
                    </tr>
                }
                </tbody>
                @if (table.Columns.Any(c => c.Aggregate != ColumnAggregate.None))
                {
                    <tfoot>
                    <tr>
                        @foreach (var column in table.Columns)
                        {
                            <td style="@AlignStyle(column)">@(column.Aggregate != ColumnAggregate.None ? "Σ" : "")</td>
                        }
                    </tr>
                    </tfoot>
                }
            </table>
        </div>
        break;
}

@code {
    [Parameter, EditorRequired] public required ReportElement Element { get; set; }

    private static string ExpressionLabel(TextTemplate.TextExpression expression) =>
        expression.Parameter is { } parameter ? "@" + parameter : $"{expression.DataSet}.{expression.Column}";

    private static List<ColumnDefinition> Columns(TableElement table) =>
        table.Columns.Count > 0
            ? table.Columns
            : [new() { Field = "Column A" }, new() { Field = "Column B" }, new() { Field = "Column C" }];

    // Mirrors the real table's explicit alignment; Auto stays left (no data to sniff).
    private static string? AlignStyle(ColumnDefinition column) => column.Align switch
    {
        ColumnAlignment.Left => "text-align:left",
        ColumnAlignment.Center => "text-align:center",
        ColumnAlignment.Right => "text-align:right",
        _ => null,
    };

    private static int GhostWidth(int row, int col) => 45 + (row * 17 + col * 29) % 45;

    private static string ChartGhost(ChartType type) => type switch
    {
        ChartType.Line =>
            "<svg viewBox='0 0 400 150' preserveAspectRatio='none' style='width:100%;height:100%'>" +
            "<polyline points='20,120 80,70 150,90 220,45 290,60 380,25' fill='none' stroke='#b9bdc4' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>" +
            "<circle cx='20' cy='120' r='5' fill='#b9bdc4'/><circle cx='150' cy='90' r='5' fill='#b9bdc4'/>" +
            "<circle cx='290' cy='60' r='5' fill='#b9bdc4'/><circle cx='380' cy='25' r='5' fill='#b9bdc4'/>" +
            "<line x1='10' y1='140' x2='390' y2='140' stroke='#d0d3d8' stroke-width='2'/></svg>",
        ChartType.Pie =>
            "<svg viewBox='0 0 150 150' style='height:100%;max-width:100%'>" +
            "<circle cx='75' cy='75' r='60' fill='#d0d3d8'/>" +
            "<path d='M 75 75 L 75 15 A 60 60 0 0 1 129 100 Z' fill='#b9bdc4'/>" +
            "<path d='M 75 75 L 129 100 A 60 60 0 0 1 90 133 Z' fill='#a4a9b1'/></svg>",
        _ =>
            "<svg viewBox='0 0 400 150' preserveAspectRatio='none' style='width:100%;height:100%'>" +
            "<rect x='30' y='60' width='40' height='80' rx='4' fill='#b9bdc4'/>" +
            "<rect x='100' y='30' width='40' height='110' rx='4' fill='#d0d3d8'/>" +
            "<rect x='170' y='75' width='40' height='65' rx='4' fill='#b9bdc4'/>" +
            "<rect x='240' y='45' width='40' height='95' rx='4' fill='#d0d3d8'/>" +
            "<rect x='310' y='90' width='40' height='50' rx='4' fill='#b9bdc4'/>" +
            "<line x1='10' y1='140' x2='390' y2='140' stroke='#d0d3d8' stroke-width='2'/></svg>",
    };
}
