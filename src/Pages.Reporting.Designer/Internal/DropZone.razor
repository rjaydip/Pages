@namespace Pages.Reporting.Designer.Internal

<div class="rd-zone @(Wide ? "rd-zone-wide" : null) @(Dragging ? "rd-zone-on" : null) @(_over ? "rd-zone-hover" : null)"
     @ondragover:preventDefault
     @ondragenter="() => _over = true"
     @ondragleave="() => _over = false"
     @ondrop="Drop" @ondrop:preventDefault>
    @if (Wide)
    {
        <span class="rd-zone-hint">Drag components here from the left</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public required List<ReportElement> TargetList { get; set; }
    [Parameter] public int Index { get; set; }
    [Parameter] public bool Dragging { get; set; }
    [Parameter] public bool AllowSections { get; set; } = true;
    [Parameter] public bool Wide { get; set; }
    [Parameter] public EventCallback<(List<ReportElement>, int, bool)> OnDrop { get; set; }

    private bool _over;

    private async Task Drop()
    {
        _over = false;
        await OnDrop.InvokeAsync((TargetList, Index, AllowSections));
    }
}
