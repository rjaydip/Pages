@page "/reports/new"
@page "/reports/{Id:int}/builder"
@rendermode InteractiveServer
@using global::Pages.Reporting.Core.Serialization
@using global::Pages.Reporting.Demo.Components.Builder
@inject ReportRepository Reports
@inject ReportJson ReportJson
@inject NavigationManager Nav

<PageTitle>Report builder — Pages.Reporting demo</PageTitle>

@if (_report is null)
{
    <p>Report not found.</p>
}
else
{
    <div class="demo-toolbar">
        <a class="demo-button" href="@(Id is int id ? $"/reports/{id}" : "/")">← Back</a>
        <span class="spacer"></span>
        <button class="demo-button" @onclick="Preview">Preview</button>
        <button class="demo-button primary" @onclick="Save">Save</button>
    </div>

    @if (_error is not null)
    {
        <div class="demo-error">@_error</div>
    }
    @if (_saved)
    {
        <div class="demo-success">Saved.</div>
    }

    <div class="b-panel demo-card">
        <h2 class="b-head">Report settings</h2>
        <div class="b-grid">
            <label class="b-field"><span>Report name</span><input @bind="_report.Name" /></label>
            <label class="b-field">
                <span>PDF page size</span>
                <select @bind="_report.Page.Size">
                    <option>A4</option>
                    <option>A3</option>
                    <option>Letter</option>
                    <option>Legal</option>
                </select>
            </label>
            <label class="b-field b-check">
                <input type="checkbox" @bind="_report.Page.Landscape" />
                <span>Landscape PDF</span>
            </label>
        </div>
    </div>

    <div class="b-panel demo-card">
        <h2 class="b-head">Connections</h2>
        <p class="demo-note">
            Referenced by name from element bindings. Connection strings are encrypted when the
            report is saved — an existing one shows its <code>enc:v1:…</code> token; paste a new
            plaintext value to replace it.
        </p>
        @foreach (var connection in _report.Connections)
        {
            <div class="b-column-row b-connection" @key="connection">
                <input placeholder="Name" @bind="connection.Name" />
                <select @bind="connection.Provider">
                    <option value="@DatabaseProvider.Sqlite">SQLite</option>
                    <option value="@DatabaseProvider.SqlServer">SQL Server</option>
                    <option value="@DatabaseProvider.PostgreSql">PostgreSQL</option>
                    <option value="@DatabaseProvider.MySql">MySQL</option>
                </select>
                <input class="b-wide" placeholder="Connection string" @bind="connection.ConnectionString" />
                <button type="button" class="b-icon b-danger" title="Remove connection"
                        @onclick="() => _report.Connections.Remove(connection)">✕</button>
            </div>
        }
        <button type="button" class="demo-button b-small" @onclick="AddConnection">+ Add connection</button>
    </div>

    <div class="b-panel demo-card">
        <h2 class="b-head">Bands</h2>
        <p class="demo-note">
            The report prints these bands top to bottom. Page header/footer repeat on every
            page; a table band grows with its data and holds exactly one table.
        </p>
        @for (var i = 0; i < _report.Bands.Count; i++)
        {
            var index = i;
            var band = _report.Bands[index];
            <div class="b-item" @key="band">
                <div class="b-item-head b-column-row">
                    <select value="@band.Type" title="Band type" @onchange="e => ChangeBandType(band, e)">
                        @foreach (var type in AddableBandTypes)
                        {
                            <option value="@type" disabled="@(type == BandType.Table && !BandTypes.CanHoldTable(band))">@BandTypeLabel(type)</option>
                        }
                    </select>
                    <input placeholder="Band name" @bind="band.Name" />
                    @if (band.Type != BandType.Table)
                    {
                        <input type="number" step="0.5"
                               min="@BandTypes.MinBandHeightMm.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               placeholder="Height (mm)" @bind="band.HeightMm" @bind:after="() => CommitBandHeight(band)" />
                    }
                    <span class="spacer"></span>
                    <button type="button" class="b-icon" title="Move up" disabled="@(index == 0)"
                            @onclick="() => MoveBand(index, -1)">↑</button>
                    <button type="button" class="b-icon" title="Move down" disabled="@(index == _report.Bands.Count - 1)"
                            @onclick="() => MoveBand(index, 1)">↓</button>
                    <button type="button" class="b-icon b-danger" title="Remove band"
                            @onclick="() => _report.Bands.RemoveAt(index)">✕</button>
                </div>
                @if (band.Type != BandType.Table && !BandTypes.CanHoldTable(band))
                {
                    <span class="demo-note" style="margin:0">
                        Can't switch to Table: a table band holds only one table, so this band's
                        existing components must be removed first.
                    </span>
                }
                @if (band.Type == BandType.Table)
                {
                    @* Exactly one table per Table band — no generic add-element control here. *@
                    @if (band.Elements.FirstOrDefault(element => element is TableElement) is TableElement table)
                    {
                        <div class="b-item">
                            <div class="b-item-head">
                                <span class="b-type">Table</span>
                                <span class="spacer"></span>
                                <button type="button" class="b-icon b-danger" title="Remove table"
                                        @onclick="() => band.Elements.Remove(table)">✕</button>
                            </div>
                            <ElementEditor Element="table" Report="_report" />
                        </div>
                    }
                    <div class="b-add">
                        <button type="button" class="demo-button b-small" disabled="@(band.Elements.Count > 0)"
                                @onclick="() => AddTable(band)">+ Add table</button>
                        @if (band.Elements.Count > 0)
                        {
                            <span class="demo-note" style="margin:0">A table band holds exactly one table.</span>
                        }
                    </div>
                }
                else
                {
                    <ElementListEditor Elements="band.Elements" Report="_report" IsBandElements="true" />
                }
            </div>
        }
        <div class="b-add">
            <select @bind="_newBandType">
                @foreach (var type in AddableBandTypes)
                {
                    <option value="@type">@BandTypeLabel(type)</option>
                }
            </select>
            <button type="button" class="demo-button" @onclick="AddBand">+ Add band</button>
        </div>
    </div>

    @if (_showPreview)
    {
        <div class="b-panel demo-card">
            <h2 class="b-head">Preview</h2>
            <ReportView Report="_report" @key="_previewVersion" />
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private Report? _report;
    private int? _loadedId = -1; // sentinel so first OnParametersSet always loads
    private bool _showPreview;
    private int _previewVersion;
    private string? _error;
    private bool _saved;
    private BandType _newBandType = BandType.Content;

    // Mirrors Pages.Reporting.Designer.Internal.BandLabels.Addable/Label: same non-group
    // band types — this simple form-based builder deliberately does not offer group bands —
    // duplicated here rather than referenced because that type is internal to the designer
    // library and this form builder is a separate, deliberately simpler consumer.
    private static readonly BandType[] AddableBandTypes =
    [
        BandType.ReportTitle,
        BandType.PageHeader,
        BandType.Content,
        BandType.Table,
        BandType.PageFooter,
        BandType.ReportSummary,
    ];

    private static string BandTypeLabel(BandType type) => type switch
    {
        BandType.ReportTitle => "Report title",
        BandType.PageHeader => "Page header",
        BandType.Content => "Content",
        BandType.Table => "Table",
        BandType.PageFooter => "Page footer",
        BandType.ReportSummary => "Report summary",
        _ => "Band",
    };

    protected override void OnParametersSet()
    {
        if (_loadedId == Id)
            return;
        _loadedId = Id;

        if (Id is int id)
        {
            var stored = Reports.Get(id);
            _report = stored is null ? null : ReportJson.Deserialize(stored.Json);
        }
        else
        {
            _report = new Report { Name = "New report" };
        }
    }

    private void AddConnection() =>
        _report!.Connections.Add(new ConnectionDefinition
        {
            Name = _report.Connections.Count == 0 ? "main" : $"connection{_report.Connections.Count + 1}",
            Provider = DatabaseProvider.Sqlite,
            ConnectionString = string.Empty,
        });

    private void AddBand() =>
        _report!.Bands.Add(new PageBand { Type = _newBandType, Name = BandTypeLabel(_newBandType) });

    private void ChangeBandType(PageBand band, ChangeEventArgs e)
    {
        if (!Enum.TryParse<BandType>(e.Value?.ToString(), out var type))
            return;
        // Mirrors the disabled state on the <option> above so the two can't drift: a Table band
        // holds exactly one TableElement, so switching in existing non-table content would strand
        // it — invisible on screen and in the PDF, yet still resolved and still written to Excel.
        if (type == BandType.Table && !BandTypes.CanHoldTable(band))
            return;
        band.Type = type;
    }

    private void MoveBand(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _report!.Bands.Count)
            return;
        (_report.Bands[index], _report.Bands[target]) = (_report.Bands[target], _report.Bands[index]);
    }

    // step/min on a bare <input type="number"> are advisory — they style the field but do not
    // stop the value binding, so a typed 12.34 or 1 would reach the model unclamped. Normalising
    // here matches the designer's DesignerProperties.CommitBandHeight.
    private void CommitBandHeight(PageBand band) =>
        band.HeightMm = Math.Max(Math.Round(band.HeightMm * 2) / 2, BandTypes.MinBandHeightMm);

    private void AddTable(PageBand band) =>
        band.Elements.Add(new TableElement
        {
            Title = "New table",
            Binding = new SqlBinding
            {
                Connection = _report!.Connections.FirstOrDefault()?.Name ?? string.Empty,
                Sql = string.Empty,
            },
        });

    private void Preview()
    {
        _showPreview = true;
        _previewVersion++; // recreate ReportView so it re-resolves the edited definition
    }

    private void Save()
    {
        _error = null;
        _saved = false;
        try
        {
            var json = ReportJson.Serialize(_report!); // encrypts any plaintext connection strings
            if (Id is int id)
            {
                Reports.Save(id, _report!.Name, json);
                _saved = true;
            }
            else
            {
                var newId = Reports.Insert(_report!.Name, json);
                Nav.NavigateTo($"/reports/{newId}/builder");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
