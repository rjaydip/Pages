@page "/reports/{Id:int}/edit"
@rendermode InteractiveServer
@using global::Pages.Reporting.Core.Serialization
@inject ReportRepository Reports
@inject ReportJson ReportJson

<PageTitle>Edit report — Pages.Reporting demo</PageTitle>

@if (_report is null)
{
    <p>Report not found.</p>
}
else
{
    <div class="demo-toolbar">
        <a class="demo-button" href="/reports/@Id">← Back to report</a>
        <span class="spacer"></span>
        <button class="demo-button primary" @onclick="Save">Save</button>
    </div>

    <p class="demo-note">
        This is the raw report definition the demo app stores on its side. Note the
        <code>connections</code> section: the connection string is an <code>enc:v1:…</code>
        token — the library encrypted it during serialization, so this JSON is safe to keep
        anywhere. Edit anything (titles, SQL, formats, chart types) and save; the report is
        regenerated from this JSON.
    </p>

    <textarea class="demo-editor" @bind="_json" spellcheck="false"></textarea>

    @if (_error is not null)
    {
        <div class="demo-error">@_error</div>
    }
    @if (_saved)
    {
        <div class="demo-success">Saved. The report will render from the updated JSON.</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private StoredReport? _report;
    private string _json = string.Empty;
    private string? _error;
    private bool _saved;

    protected override void OnParametersSet()
    {
        _report = Reports.Get(Id);
        _json = _report?.Json ?? string.Empty;
    }

    private void Save()
    {
        _error = null;
        _saved = false;
        try
        {
            // Validate + re-serialize through the library so any newly added plaintext
            // connection string gets encrypted before it is stored.
            var report = ReportJson.Deserialize(_json);
            var normalized = ReportJson.Serialize(report);
            Reports.Save(Id, report.Name, normalized);
            _json = normalized;
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
