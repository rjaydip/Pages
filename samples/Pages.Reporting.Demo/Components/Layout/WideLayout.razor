@inherits LayoutComponentBase

@* Full-width variant for the designer: palette + real-size paper sheet + properties
   panel need the whole viewport, not the 960px reading column. Uncapped on purpose —
   every pixel of width is canvas the author can lay a report out on. *@

<header class="demo-header">
    <a href="/">Pages.Reporting <span>demo</span></a>
</header>

<main class="demo-main demo-main-wide">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
