@namespace Pages.Reporting.Designer.Internal

<span class="rd-subhead">Styling</span>
@if (Style is null)
{
    <button type="button" class="rd-load" @onclick="() => StyleChanged.InvokeAsync(new ElementStyle())">+ Add styling</button>
}
else
{
    @if (TextOptions)
    {
        <div class="rd-style-checks">
            <label class="rd-check"><input type="checkbox" @bind="Style.Bold" @bind:after="Notify" /><span>Bold</span></label>
            <label class="rd-check"><input type="checkbox" @bind="Style.Italic" @bind:after="Notify" /><span>Italic</span></label>
        </div>
        <label class="rd-field">
            <span>Font</span>
            <select value="@FontPreset" @onchange="OnFontPresetChanged">
                <option value="">Default</option>
                @foreach (var group in FontStacks.All.GroupBy(font => font.Group))
                {
                    <optgroup label="@group.Key">
                        @foreach (var font in group)
                        {
                            @* Each option previews its own typeface. Desktop Chrome and Firefox
                               honour a styled <option>; some platforms ignore it, so this is a
                               nicety, never the mechanism. *@
                            <option value="@font.Stack" style="font-family:@font.Stack">@font.Label</option>
                        }
                    </optgroup>
                }
                <option value="custom">Custom…</option>
            </select>
        </label>
        @if (FontPreset == "custom")
        {
            <label class="rd-field"><span>Custom font family</span><input @bind="Style.FontFamily" @bind:event="oninput" @bind:after="Notify" placeholder="Inter, 'Segoe UI', sans-serif" /></label>
        }
        <p class="rd-hint">Fonts not installed where the PDF renders fall back to the next in the stack.</p>
        <label class="rd-field"><span>Font size (px)</span><input type="number" @bind="Style.FontSize" @bind:after="Notify" /></label>
        <label class="rd-field">
            <span>Text align</span>
            <select @bind="Style.Align" @bind:after="Notify">
                <option value="@TextAlign.Default">Default</option>
                <option value="@TextAlign.Left">Left</option>
                <option value="@TextAlign.Center">Center</option>
                <option value="@TextAlign.Right">Right</option>
            </select>
        </label>
        <label class="rd-field">
            <span>Vertical align (within the box)</span>
            <select @bind="Style.VerticalAlign" @bind:after="Notify">
                <option value="@VerticalAlign.Default">Default (top)</option>
                <option value="@VerticalAlign.Top">Top</option>
                <option value="@VerticalAlign.Middle">Middle</option>
                <option value="@VerticalAlign.Bottom">Bottom</option>
            </select>
        </label>
        <label class="rd-field">
            <span>Text color</span>
            <span class="rd-color-row">
                <input type="color" value="@Swatch(Style.Color)" @onchange="e => SetFromPicker(e, v => Style!.Color = v)" title="Pick color" />
                <input @bind="Style.Color" @bind:event="oninput" @bind:after="Notify" placeholder="#333333" />
            </span>
        </label>
        <label class="rd-field">
            <span>Background (box) color</span>
            <span class="rd-color-row">
                <input type="color" value="@Swatch(Style.Background)" @onchange="e => SetFromPicker(e, v => Style!.Background = v)" title="Pick color" />
                <input @bind="Style.Background" @bind:event="oninput" @bind:after="Notify" placeholder="#f5f5f5" />
            </span>
        </label>
    }
    @if (PaddingOption)
    {
        <label class="rd-field">
            <span>Padding</span>
            <select value="@PaddingPreset" @onchange="OnPaddingPresetChanged">
                <option value="">None</option>
                <option value="12px">Narrow (12px)</option>
                <option value="24px">Normal (24px)</option>
                <option value="32px">Moderate (32px)</option>
                <option value="48px">Wide (48px)</option>
                <option value="custom">Custom…</option>
            </select>
        </label>
        @if (PaddingPreset == "custom")
        {
            <label class="rd-field"><span>Custom padding</span><input @bind="Style.Padding" @bind:event="oninput" @bind:after="Notify" placeholder="8px or 8px 16px" /></label>
        }
    }
    <span class="rd-style-sub">Border</span>
    <div class="rd-style-checks">
        <label class="rd-check"><input type="checkbox" @bind="Style.BorderTop" @bind:after="NotifyBorder" /><span>Top</span></label>
        <label class="rd-check"><input type="checkbox" @bind="Style.BorderRight" @bind:after="NotifyBorder" /><span>Right</span></label>
        <label class="rd-check"><input type="checkbox" @bind="Style.BorderBottom" @bind:after="NotifyBorder" /><span>Bottom</span></label>
        <label class="rd-check"><input type="checkbox" @bind="Style.BorderLeft" @bind:after="NotifyBorder" /><span>Left</span></label>
    </div>
    @if (Style.HasBorder)
    {
        <label class="rd-field"><span>Border width (px)</span><input type="number" min="1" @bind="Style.BorderWidth" @bind:after="NotifyBorder" placeholder="1" /></label>
        <label class="rd-field">
            <span>Border color</span>
            <span class="rd-color-row">
                <input type="color" value="@Swatch(Style.BorderColor, "#808080")" @onchange="e => SetFromPicker(e, v => { Style!.BorderColor = v; Style.Border = null; })" title="Pick color" />
                <input @bind="Style.BorderColor" @bind:event="oninput" @bind:after="NotifyBorder" placeholder="#808080" />
            </span>
        </label>
    }
    <label class="rd-field"><span>Custom border CSS (overrides the options above)</span><input @bind="Style.Border" @bind:event="oninput" @bind:after="Notify" placeholder="e.g. 2px dashed #1a66c2" /></label>
    <button type="button" class="rd-load" @onclick="() => StyleChanged.InvokeAsync(null)">Remove styling</button>
}

@code {
    [Parameter] public ElementStyle? Style { get; set; }
    [Parameter] public EventCallback<ElementStyle?> StyleChanged { get; set; }

    /// <summary>False = box-only mode (padding + border) — used for the page.</summary>
    [Parameter] public bool TextOptions { get; set; } = true;

    /// <summary>False hides the padding controls — text boxes don't need padding.</summary>
    [Parameter] public bool PaddingOption { get; set; } = true;

    private static readonly string[] PaddingPresets = ["", "12px", "24px", "32px", "48px"];

    private bool _customPadding;
    private bool _customFont;
    private ElementStyle? _lastStyle;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Style, _lastStyle))
        {
            _lastStyle = Style;
            _customPadding = false;
            _customFont = false;
        }
    }

    // Fields mutate Style in place, so the bound value never "changes" on its own —
    // re-invoke StyleChanged after every edit so the host re-renders the live canvas.
    private Task Notify() => StyleChanged.InvokeAsync(Style);

    // Editing the structured border options must win over the custom CSS shorthand —
    // otherwise a leftover "border: 1px solid …" silently overrides the side checkboxes.
    private Task NotifyBorder()
    {
        Style!.Border = null;
        return Notify();
    }

    // The native picker needs a #rrggbb value; fall back when the text is empty or a named color.
    private static string Swatch(string? value, string fallback = "#1c1e21") =>
        value is { Length: 7 } && value[0] == '#' ? value : fallback;

    private async Task SetFromPicker(ChangeEventArgs e, Action<string?> assign)
    {
        assign((string?)e.Value);
        await Notify();
    }

    private string PaddingPreset =>
        _customPadding ? "custom"
        : PaddingPresets.Contains(Style?.Padding ?? string.Empty) ? Style?.Padding ?? string.Empty
        : "custom";

    private async Task OnPaddingPresetChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value ?? string.Empty;
        if (value == "custom")
        {
            _customPadding = true;
            return;
        }
        _customPadding = false;
        Style!.Padding = string.IsNullOrEmpty(value) ? null : value;
        await Notify();
    }

    // A stack that matches no preset is a hand-authored one — show it in the Custom box
    // rather than silently resetting the author's font to Default.
    private string FontPreset =>
        _customFont ? "custom"
        : string.IsNullOrWhiteSpace(Style?.FontFamily) ? string.Empty
        : FontStacks.IsPreset(Style!.FontFamily) ? Style!.FontFamily!
        : "custom";

    private async Task OnFontPresetChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value ?? string.Empty;
        if (value == "custom")
        {
            _customFont = true;
            return;
        }
        _customFont = false;
        Style!.FontFamily = string.IsNullOrEmpty(value) ? null : value;
        await Notify();
    }
}
