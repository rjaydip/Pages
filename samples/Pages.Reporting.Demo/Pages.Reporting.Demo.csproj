<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pages.Reporting\Pages.Reporting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- A sample, not a shipped package: stated explicitly so `dotnet pack` on the solution
         skips it silently instead of warning that packaging is disabled. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
