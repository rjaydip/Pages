@using global::Pages.Reporting.Core.Serialization
@inject ReportJson ReportJson
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="rd-root" @ref="_root">
    <div class="rd-toolbar">
        <input class="rd-name" @bind="_report.Name" title="Report name" />
        <span class="rd-divider"></span>
        <button type="button" class="@(_selection is PageSelection ? "rd-active" : null)" @onclick="SelectPage">Page</button>
        <span class="rd-spacer"></span>
        @if (_savedFlash)
        {
            <span class="rd-saved">Saved ✓</span>
        }
        <button type="button" class="@(_showPreview ? "rd-active" : null)" @onclick="Preview">Preview</button>
        <button type="button" class="rd-primary" @onclick="Save">Save</button>
    </div>

    @if (_showPreview)
    {
        <div class="rd-preview">
            <div class="rd-preview-head">
                <span>Preview</span>
                <span class="rd-spacer"></span>
                <button type="button" @onclick="() => _showPreview = false">← Back to editing</button>
            </div>
            <div class="rd-preview-stage">
                @* Same paper sheet as the canvas; ReportView applies the page Style itself. *@
                <div class="rd-page" style="@SheetCss()">
                    <ReportView Report="_report" @key="_previewVersion" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="rd-layout">
            <DesignerSidebar Report="_report"
                             Selection="_selection"
                             OnDragStart="StartPaletteDrag"
                             OnDragEnd="EndDrag"
                             OnSelectItem="SelectItem" />

            <div class="rd-canvas" @onclick="SelectPage">
                @* The white sheet has the report's real paper dimensions (Page settings);
                   its padding is the print margin, and page-level Style shows live inside
                   it — the same nesting the PDF uses (@@page margin around pr-report). *@
                <div class="rd-page" style="@SheetCss()">
                    <div class="rd-page-body" style="@StyleCss.Page(_report.Style)">
                        <CanvasList Elements="_report.Elements"
                                    Selected="@(_selection as ReportElement)"
                                    Dragging="@(_drag is not null)"
                                    ShowGrid="@(_drag is not null)"
                                    Spacing="@_report.Spacing"
                                    AllowSections="true"
                                    OnSelect="Select"
                                    OnRemove="Remove"
                                    OnMoveStart="StartMove"
                                    OnDragEnd="EndDrag"
                                    OnDrop="HandleDrop" />
                    </div>
                </div>
            </div>

            <DesignerProperties Selection="_selection" Report="_report"
                                OnChanged="StateHasChanged"
                                OnRemoveItem="RemoveItem" />
        </div>
    }
</div>

@code {
    /// <summary>Existing report JSON to edit; omit to start with an empty canvas.</summary>
    [Parameter] public string? Json { get; set; }

    /// <summary>
    /// Fires with the updated report JSON (connection strings encrypted) when the user saves.
    /// The designer persists nothing — what happens with the JSON is the host's decision.
    /// </summary>
    [Parameter] public EventCallback<string> OnSave { get; set; }

    private Report _report = new() { Name = "New report" };
    private object? _selection; // ReportElement | PageSelection | ConnectionDefinition | DataSetDefinition | ParameterDefinition
    private DragPayload? _drag;
    private bool _showPreview;
    private int _previewVersion;
    private bool _savedFlash;
    private string? _loadedJson;
    private bool _initialized;
    private ElementReference _root;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (_initialized && Json == _loadedJson)
            return;
        _initialized = true;
        _loadedJson = Json;
        _report = Json is null ? new Report { Name = "New report" } : ReportJson.Deserialize(Json);
        _selection = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Pages.Reporting.Designer/ReportDesigner.razor.js");
                await _module.InvokeVoidAsync("attach", _root);
            }
            catch (JSException)
            {
                // The module only smooths the HTML5 drag handshake (needed by Firefox).
                // If it fails to load, the designer must keep working — don't kill the circuit.
            }
        }
    }

    private void Select(ReportElement element) => _selection = element;

    private void SelectPage() => _selection = PageSelection.Instance;

    private void SelectItem(object item) => _selection = item;

    private void Remove(ReportElement element)
    {
        RemoveFrom(_report.Elements, element);
        if (ReferenceEquals(_selection, element))
            _selection = null;
    }

    private void RemoveItem(object item)
    {
        switch (item)
        {
            case ReportElement element:
                Remove(element);
                return;
            case ConnectionDefinition connection:
                _report.Connections.Remove(connection);
                break;
            case DataSetDefinition dataSet:
                _report.DataSets.Remove(dataSet);
                break;
            case ParameterDefinition parameter:
                _report.Parameters.Remove(parameter);
                break;
        }
        if (ReferenceEquals(_selection, item))
            _selection = null;
    }

    private static bool RemoveFrom(List<ReportElement> list, ReportElement element)
    {
        if (list.Remove(element))
            return true;
        foreach (var section in list.OfType<SectionElement>())
            if (RemoveFrom(section.Children, element))
                return true;
        return false;
    }

    private void StartPaletteDrag(string type) => _drag = new DragPayload { PaletteType = type };

    private void StartMove((ReportElement Element, List<ReportElement> Source) move) =>
        _drag = new DragPayload { Existing = move.Element, SourceList = move.Source };

    private void EndDrag() => _drag = null;

    private void HandleDrop((List<ReportElement> Target, int Index, bool AllowSections) drop)
    {
        var drag = _drag;
        _drag = null;
        if (drag is null)
            return;

        if (drag.PaletteType is { } type)
        {
            if (type == "section" && !drop.AllowSections)
                return; // sections nest one level only
            var element = CreateElement(type);
            drop.Target.Insert(Math.Min(drop.Index, drop.Target.Count), element);
            Select(element);
            return;
        }

        if (drag is { Existing: { } moved, SourceList: { } source })
        {
            if (moved is SectionElement && !drop.AllowSections)
                return;
            var index = drop.Index;
            var oldIndex = source.IndexOf(moved);
            if (oldIndex < 0)
                return;
            source.RemoveAt(oldIndex);
            if (ReferenceEquals(source, drop.Target) && oldIndex < index)
                index--;
            drop.Target.Insert(Math.Min(index, drop.Target.Count), moved);
            Select(moved);
        }
    }

    private ReportElement CreateElement(string type)
    {
        var dataSet = _report.DataSets.FirstOrDefault()?.Name ?? string.Empty;
        DataSetBinding NewBinding() => new() { Name = dataSet };

        return type switch
        {
            "kpiCard" => new KpiCardElement { Label = "New KPI", Binding = NewBinding() },
            "table" => new TableElement { Binding = NewBinding() },
            "chart" => new ChartElement { LabelField = string.Empty, Binding = NewBinding() },
            "section" => new SectionElement { Direction = SectionDirection.Row },
            _ => new TextElement { Content = "New text" },
        };
    }

    // Real paper dimensions (shared with hosts via PageSheet), so the sheet visually IS
    // an A4/A3/… page; the sheet's padding is the PDF print margin.
    private string SheetCss() => PageSheet.Css(_report.Page);

    private void Preview()
    {
        _showPreview = true;
        _previewVersion++; // recreate ReportView so it re-resolves the edited definition
    }

    private async Task Save()
    {
        var json = ReportJson.Serialize(_report); // encrypts any plaintext connection strings
        _loadedJson = json; // a host echoing the JSON back as a parameter must not reset the canvas
        _savedFlash = true;
        await OnSave.InvokeAsync(json);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // circuit already gone — nothing to clean up
        }
    }

    internal sealed class DragPayload
    {
        public string? PaletteType { get; init; }
        public ReportElement? Existing { get; init; }
        public List<ReportElement>? SourceList { get; init; }
    }
}
