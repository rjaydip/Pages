@* Resolved template text ({dataSet.Column:agg:fmt} placeholders already replaced by the
   resolver). Plain mode keeps the author's line breaks (pre-wrap); HTML mode renders the
   author's own tags and leaves whitespace handling to them. *@
@if (Element.RenderHtml)
{
    <div class="pr-text @Element.CssClass"
         style="@StyleCss.Concat("margin:0;", StyleCss.Inline(Element.Style))">@((MarkupString)(Data.Scalar?.ToString() ?? string.Empty))</div>
}
else
{
    <div class="pr-text @Element.CssClass"
         style="@StyleCss.Concat("margin:0;white-space:pre-wrap;", StyleCss.Inline(Element.Style))">@(Data.Scalar?.ToString())</div>
}

@code {
    [Parameter, EditorRequired] public required TextElement Element { get; set; }
    [CascadingParameter] public required ResolvedReport Resolved { get; set; }

    private ResolvedData Data => Resolved.GetData(Element);
}
