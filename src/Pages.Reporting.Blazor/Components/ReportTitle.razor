@* Structural type scale (like the table's borders): identical in designer, screen and
   PDF without developer CSS; Element.Style and developer hooks override it. *@
<header class="pr-title @Element.CssClass"
        style="@StyleCss.Concat("display:flex;flex-direction:column;gap:2px;", StyleCss.Container(Element.Style))">
    <h1 style="@StyleCss.Concat("margin:0;font-size:24px;font-weight:650;", StyleCss.Text(Element.Style))">@Element.Text</h1>
    @if (!string.IsNullOrEmpty(Element.Subtitle))
    {
        <p style="margin:0;font-size:13.5px;color:#6a6f76">@Element.Subtitle</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public required TitleElement Element { get; set; }
}
